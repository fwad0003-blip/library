# Copy to .env.local and fill in from Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL printed by `firebase deploy --only functions` for countBooks
VITE_COUNT_BOOKS_URL=
# URL printed by the deploy for getAllBooks (eFolio 10.2)
VITE_GET_ALL_BOOKS_URL=

# Free key from https://home.openweathermap.org/api_keys (eFolio 10.1 / 10.2)
VITE_OPENWEATHER_API_KEY=

# Optional: point the app at local emulators instead of the real project
# VITE_USE_EMULATORS=true
